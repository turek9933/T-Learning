# Server
HOST=localhost
PORT=3002
NODE_ENV=development
APP_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# Database
DB_USER=user
DB_PASSWORD=password
DB_NAME=t-learning
DB_PORT=5432
DB_URL=postgresql://user:password@localhost:5432/t-learning

# Mail Resend
RESEND_API_KEY=key-from-resend.com
RESEND_EMAIL_ADDRESS=onboarding@resend.dev

# JWT
JWT_SECRET=super-secret-jwt-key

# Better Auth
BETTER_AUTH_API_KEY=your-better-auth-api-key
BETTER_AUTH_SECRET=better-auth-secret
BETTER_AUTH_URL=http://localhost:3002
SESSION_EXPIRATION_DAYS=14
SESSION_UPDATE_DAYS=2
PASSWORD_MIN_LENGTH=10

# Open Google Cloud Console → APIs & Services → Credentials
# Click Create Credentials → OAuth client ID
# Choose Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=password
MINIO_ENDPOINT=http://localhost:3012
MINIO_PUBLIC_URL=http://localhost:3012
# CORS origins for MinIO (browser uploads via presigned URLs) - JSON array
MINIO_CORS_ORIGINS=["http://localhost:3001"]
MINIO_PORT=3012
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=tlearning
MINIO_FORCE_PATH_STYLE=true
MINIO_PRESIGNED_EXPIRY=3600