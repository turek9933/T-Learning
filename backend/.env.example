# Server
HOST=localhost
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Database
DB_USER=user
DB_PASSWORD=password
DB_NAME=t-learning
DB_PORT=5432
DB_URL=postgresql://user:password@localhost:5432/t-learning

# Mail Resend
RESEND_API_KEY=key-from-resend.com
RESEND_EMAIL_ADDRESS=onboarding@resend.dev

# JWT
JWT_SECRET=super-secret-jwt-key

# Better Auth
BETTER_AUTH_SECRET=better-auth-secret
BETTER_AUTH_URL=http://localhost:3001
SESSION_EXPIRATION_DAYS=14
SESSION_UPDATE_DAYS=2
PASSWORD_MIN_LENGHT=10

# Open Google Cloud Console → APIs & Services → Credentials
# Click Create Credentials → OAuth client ID
# Choose Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=password
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=tlearning
MINIO_FORCE_PATH_STYLE=true
MINIO_PRESIGNED_EXPIRY=3600

# Stripe
STRIPE_SECRET_KEY=stripe_key
STRIPE_WEBHOOK_SECRET=webhook_secret

# OneSignal
ONESIGNAL_APP_ID=onesignal_id
ONESIGNAL_REST_API_KEY=rest_api_key